training_runs/

# partykit dev's local Durable Object storage (room state persisted across
# `partykit dev` restarts) — never committed, purely local dev state.
.partykit/
.planning/

# miniflare's local cache/state directory, written by `partykit dev` under
# node_modules (which this repo otherwise tracks) — purely local dev state,
# same class as .partykit/ above.
node_modules/.mf/

# Build output. `npx vite build` regenerates this from source, and Plan 05-02's
# deploy builds it fresh rather than serving a committed copy — a tracked dist/
# only churns a 99 MB tree on every build and invites someone to hand-deploy a
# stale bundle. dist-verify/ is the throwaway output dir the room-host build
# guard's verification builds into.
dist/
dist-verify/

# macOS Finder metadata — never meaningful to the app.
.DS_Store
