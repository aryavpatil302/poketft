{
  "name": "pokemon-tft-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cucumber-js e2e/features/**/*.feature",
    "test:e2e:ability": "cucumber-js",
    "train-bots": "tsx src/econ/train.ts",
    "train-comps": "tsx src/econ/trainCompositionAffinities.ts",
    "train-catalog": "tsx src/econ/trainCatalogComps.ts",
    "grow-catalog": "tsx src/econ/growCatalog.ts",
    "train-all": "tsx src/econ/trainAll.ts",
    "sim-bots": "tsx src/sim/botLeague.ts",
    "deploy:preflight": "tsx scripts/deployPreflight.ts",
    "room:dev": "partykit dev",
    "room:smoke": "tsx scripts/roomSmoke.ts",
    "room:seats": "tsx scripts/roomSeats.ts",
    "room:round": "tsx scripts/roomRound.ts",
    "net:client": "tsx scripts/netClient.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@types/node": "^26.1.1",
    "chromedriver": "^148.0.4",
    "partykit": "^0.0.115",
    "selenium-webdriver": "^4.44.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "partysocket": "^1.3.0"
  }
}
