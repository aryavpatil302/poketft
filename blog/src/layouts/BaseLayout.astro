---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  image?: string
}

const {
  title,
  description = 'A Pokemon-themed auto-battler — design devlog.',
  image,
} = Astro.props

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href

// Astro.url.pathname includes `base`, so comparing it directly against '/'
// or '/about' would never match once base is set to '/blog/'. Normalize both
// sides by stripping trailing slashes before comparing.
const basePath = import.meta.env.BASE_URL.replace(/\/+$/, '')
const path = Astro.url.pathname.replace(/\/+$/, '')
const isHome = path === basePath
const isBlog = path.startsWith(`${basePath}/blog`)
const isAbout = path === `${basePath}/about`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    {image && <meta property="og:image" content={image} />}

    <!-- Favicon placeholder — replace public/favicon.svg with your own -->
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>

  <body>
    <header class="site-header">
      <a href={import.meta.env.BASE_URL} class="site-logo-link" aria-label="PokeFight — home">
        <!--
          Save your logo PNG as: public/logo.png
          If the file is missing the text fallback renders instead.
        -->
        <img
          src={`${import.meta.env.BASE_URL}logo.png`}
          alt="PokeFight"
          class="site-logo"
          onerror="this.style.display='none'; document.getElementById('logo-fallback').style.display='block'"
        />
        <span id="logo-fallback" class="site-logo-text">PokeFight</span>
      </a>

      <nav class="site-nav" aria-label="Main navigation">
        <a href={import.meta.env.BASE_URL} aria-current={isHome ? 'page' : undefined}>Home</a>
        <a href={`${import.meta.env.BASE_URL}blog`} aria-current={isBlog ? 'page' : undefined}>Blog</a>
        <a href={`${import.meta.env.BASE_URL}about`} aria-current={isAbout ? 'page' : undefined}>About</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()} PokeFight ·
        <a href="https://github.com" target="_blank" rel="noopener">GitHub</a>
      </p>
    </footer>
  </body>
</html>
