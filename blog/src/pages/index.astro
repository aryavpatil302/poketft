---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const allPosts = await getCollection('posts', ({ data }) => !data.draft)
const posts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  })
}
---

<BaseLayout title="PokeFight — A Pokemon Auto-Battler Devlog">
  <div class="page page--wide">

    <!-- Intro -->
    <section class="intro">
      <div class="intro-text">
        <h1 class="intro-headline">
          Building a Pokemon<br /><em>auto-battler</em><br />from scratch.
        </h1>
        <div class="intro-body">
          <p>
            PokeFight is an original auto-battler set in the Pokemon world —
            every unit, trait, and mechanic designed from the ground up.
          </p>
          <p>
            This blog documents the thinking behind it: how I pick Pokemon for
            each trait, how abilities translate from the games, how I approach
            balance, and what it actually takes to build a competitive game.
          </p>
        </div>
      </div>

      <div class="intro-image">
        <!--
          Add a gameplay screenshot here:
          public/images/game-screenshot.png
          If the file is missing this column is hidden.
        -->
        <img
          src={`${import.meta.env.BASE_URL}images/game-screenshot.png`}
          alt="PokeFight gameplay"
          class="intro-screenshot"
          onerror="this.parentElement.style.display='none'"
        />
      </div>
    </section>

    <!-- Latest posts -->
    <section class="post-list-section">
      <p class="section-label">Recent posts</p>
      <ul class="post-list" role="list">
        {posts.map((post) => (
          <li class="post-item">
            <div class="post-meta">
              <time class="post-date" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
            </div>
            <a href={`${import.meta.env.BASE_URL}blog/${post.slug}`} class="post-title-link">
              <h2 class="post-list-title">{post.data.title}</h2>
            </a>
            <p class="post-excerpt">{post.data.description}</p>
            <a href={`${import.meta.env.BASE_URL}blog/${post.slug}`} class="read-more">Read</a>
          </li>
        ))}
      </ul>
    </section>

  </div>
</BaseLayout>
